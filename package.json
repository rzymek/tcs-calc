{
  "name": "tcs-calc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "preview": "vite preview",
    "build": "npm-run-all clean -p check:* bundle",
    "clean": "rm -rf dist",
    "check:test": "vitest --run --project unit",
    "test:screenshots": "vitest --run --project browser",
    "check:types": "tsc -b; rm -f *.js *.d.ts *.tsbuildinfo",
    "find-unused": "knip --production",
    "bundle": "run-s build:*",
    "build:bundle": "vite build",
    "build:icons": "pwa-assets-generator --root dist --preset minimal-2023 icon.svg"
  },
  "dependencies": {
    "branded-types": "^1.0.2",
    "preact": "^11.0.1",
    "remeda": "^2.52.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitest/browser-playwright": "5.0.5",
    "knip": "^6.42.0",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ],
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
