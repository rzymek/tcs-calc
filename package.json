{
  "name": "tcs-calc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "preview": "vite preview",
    "build": "npm-run-all clean -p check:* bundle",
    "clean": "rm -rf dist",
    "check:test": "vitest --run",
    "check:types": "tsc -b; rm -f *.js *.d.ts *.tsbuildinfo",
    "bundle": "run-s build:*",
    "build:bundle": "vite build",
    "build:icons": "pwa-assets-generator --root dist --preset minimal-2023 icon.svg"
  },
  "dependencies": {
    "branded-types": "^1.0.2",
    "preact": "^11.0.1",
    "react-dice-roll": "^1.2.2",
    "remeda": "^2.52.0",
    "vite-static-assets-plugin": "^3.1.1"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx-source": "^7.29.7",
    "@preact/preset-vite": "^2.10.6",
    "@vite-pwa/assets-generator": "^2.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ],
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
